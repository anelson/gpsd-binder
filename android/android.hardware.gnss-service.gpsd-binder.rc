# gpsd-binder: AIDL android.hardware.gnss (version 2) driver backed by gpsd.
# Install as /vendor/etc/init/android.hardware.gnss-service.gpsd-binder.rc.
#
# For each GNSS session the service starts /vendor/bin/gpsd-binder-relay, which
# connects to gpsd at vendor.gpsd.host:vendor.gpsd.port. If the properties are
# not set, it uses 127.0.0.1:2947, gpsd's own default. To use another address,
# set the properties from a separate init file, as
# waydroid/gpsd-binder-waydroid.rc does.
#
# The relay runs with the service's user and groups: inet lets it open sockets
# on kernels that restrict them to that group.

service vendor.gnss-gpsd-binder /vendor/bin/hw/android.hardware.gnss-service.gpsd-binder
    interface aidl android.hardware.gnss.IGnss/default
    class hal
    user gps
    group gps inet
